{
  "version": 1,
  "workspaces": [
    {
      "id": "your-workspace",
      "rootDir": "E:/path/to/your/workspace",
      "otherRootDirs": [
        "E:/path/to/another/workspace"
      ],
      "lineEnding": "auto",
      "port": 3100,
      "logsDir": "E:/path/to/custom-mcp/logs",
      "android": {
        "workspaceRoot": "E:/AndroidStudioProjects/YourProject",
        "javaHome": "E:/Android_Studio/jbr",
        "buildTimeoutMs": 900000,
        "maxErrorBlockChars": 2500,
        "maxLogTailChars": 4000
      },
      "envOverrides": {
        "allowedFields": [
          "lineEnding",
          "logsDir",
          "android.javaHome"
        ]
      }
    }
  ]
}

{
  "name": "custom-mcp",
  "version": "1.5.0",
  "type": "module",
  "bin": {
    "custom-mcp": "./dist/index.js"
  },
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" package.json tsconfig.json tsconfig.test.json .prettierrc.json eslint.config.js",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" package.json tsconfig.json tsconfig.test.json .prettierrc.json eslint.config.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" eslint.config.js --max-warnings 0",
    "build": "tsc",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "check": "npm run format:check && npm run lint && npm run build && npm run typecheck:test",
    "test": "node --import tsx test/run-tests.ts",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "ajv": "^8.20.0",
    "chalk": "^5.6.2",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.11.1",
    "fast-xml-validator": "^1.4.2",
    "glob": "^13.0.6",
    "ignore": "7.0.10",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.0"
  },
  "engines": {
    "node": ">=22"
  }
}
